# ---------------------------------------------------------------------------
# JNCTF 环境变量
# 复制成 .env 后按需修改；docker-compose 与本地启动都会读它
# ---------------------------------------------------------------------------

# 站点对外地址，邮件链接与 OAuth 回调用
SITE_URL=http://localhost:8080
PORT=8080

# --- 数据库 --------------------------------------------------------------
POSTGRES_DB=jnctf
POSTGRES_USER=jnctf
POSTGRES_PASSWORD=jnctf-change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/jnctf
DATABASE_USERNAME=jnctf
DATABASE_PASSWORD=jnctf-change-me

# --- Redis（缓存 / 限流 / 找回密码令牌）----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- 安全 ----------------------------------------------------------------
# 生产环境务必替换：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes-long
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14

# --- 首个超级管理员（只在空库时创建）------------------------------------
ROOT_USERNAME=root
ROOT_PASSWORD=jnctf123456
ROOT_EMAIL=root@jnctf.local

# --- 上传 ----------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=100MB

# --- 邮件（可选）---------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=JNCTF <no-reply@localhost>

# --- 动态靶机（可选，需要能访问 Docker）---------------------------------
DOCKER_ENABLED=false
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=jnctf-challenges
DOCKER_PUBLIC_HOST=localhost
DOCKER_PORT_START=30000
DOCKER_PORT_END=31000
